{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["packages/**", "scripts/**", "*.ts", "*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUndeclaredDependencies": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noProcessEnv": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error",
        "noImportCycles": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": {
              "level": "error",
              "options": {
                "devDependencies": false
              }
            }
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@typesafe-ai/sdk": "Use @quarry/jev, which pins the model and validates every response."
                },
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "Library code runs in Node.js and Cloudflare Workers. Put Node-only code under src/node/."
                  },
                  {
                    "group": ["**/*.test.ts"],
                    "message": "Production code must not import test files."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/*/src/node/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@typesafe-ai/sdk": "Use @quarry/jev, which pins the model and validates every response."
                },
                "patterns": [
                  {
                    "group": ["**/*.test.ts"],
                    "message": "Production code must not import test files."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/jev/src/**", "!packages/jev/src/node/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "Library code runs in Node.js and Cloudflare Workers. Put Node-only code under src/node/."
                  },
                  {
                    "group": ["**/*.test.ts"],
                    "message": "Production code must not import test files."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/jev/src/node/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/*.test.ts"],
                    "message": "Production code must not import test files."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
